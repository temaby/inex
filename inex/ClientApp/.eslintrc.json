{
    "parser": "@typescript-eslint/parser",
    "parserOptions": {
        "ecmaVersion": 6,
        "sourceType": "module"
    },
    "plugins": [
        "@typescript-eslint"
    ],
    "overrides": [
        {
            "files": [
                "src/store/transactions/**/*.ts",
                "src/store/transactions/**/*.tsx",
                "src/components/**/*.ts",
                "src/components/**/*.tsx"
            ],
            "rules": {
                "@typescript-eslint/no-explicit-any": "warn"
            }
        }
    ]
}
