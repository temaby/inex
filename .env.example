# -- Database -----------------------------------------------------------
# Used by docker-compose to create the MySQL container and derive the API connection string.
DB_ROOT_PASSWORD=change-me-root-password
DB_NAME=inex_db
DB_USER=inex_user
DB_PASSWORD=change-me-db-password

# -- ASP.NET Core -------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:80

# -- JWT ----------------------------------------------------------------
# Must be >=32 characters. Generate with: openssl rand -base64 48
# Docker Compose maps JWT_SECRET -> JwtOptions__Secret (and so on for the others).
JWT_SECRET=change-me-generate-a-long-random-secret-min-32-chars
JWT_ISSUER=inex-api
JWT_AUDIENCE=inex-client
JWT_ACCESS_TOKEN_EXPIRY_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRY_DAYS=7

# -- Registration -------------------------------------------------------
# Invite token required to register. Must be >=8 characters.
# Generate with: openssl rand -base64 24
# Docker Compose maps INVITE_TOKEN -> InviteOptions__Token.
INVITE_TOKEN=change-me-invite-token

# -- CORS ---------------------------------------------------------------
# Production domain(s) allowed to call the API. Array syntax: __0, __1, etc.
# MUST be set before deploying -- empty list blocks all browser requests in production.
AllowedOrigins__0=https://yourdomain.com

# -- Exchange Rate API --------------------------------------------------
# Maps to CurrencyApiSettings:ApiKey in ASP.NET Core (app binding name).
# Docker Compose maps CURRENCY_API_KEY -> CurrencyApiSettings__ApiKey.
# Get a free key at https://app.currencyapi.com
CURRENCY_API_KEY=<your-currency-api-key>

# -- Design-time migrations only (not used at runtime) ------------------
# Set this before running: dotnet ef migrations add <Name>
# INEX_CONNECTION_STRING=Server=localhost;Port=3306;Database=inex_dev;User=root;Password=...

# -- dotnet user-secrets (local ASP.NET Core runs without Docker) -------
# Run from the repo root or inex/ directory. Keys use : as the nested separator.
#   dotnet user-secrets set "ConnectionStrings:InExConnection" "Server=localhost;Port=3306;Database=inex_dev;Uid=inex_user;Pwd=<DB_PASSWORD>;Convert Zero Datetime=True"
#   dotnet user-secrets set "JwtOptions:Secret"               "<JWT_SECRET value>"
#   dotnet user-secrets set "JwtOptions:Issuer"               "inex-api"
#   dotnet user-secrets set "JwtOptions:Audience"             "inex-client"
#   dotnet user-secrets set "InviteOptions:Token"             "<INVITE_TOKEN value>"
#   dotnet user-secrets set "CurrencyApiSettings:ApiKey"      "<CURRENCY_API_KEY value>"